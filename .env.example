# คัดลอกไฟล์นี้เป็นชื่อ .env แล้วใส่ค่าของคุณ

# คีย์ Claude API (สมัครที่ https://console.anthropic.com) — ถ้าไม่ใส่ ใช้ Ollama หรือโหมดไม่ใช้ AI ได้
ANTHROPIC_API_KEY=

# รุ่นของ Claude ที่ใช้สรุป
CLAUDE_MODEL=claude-sonnet-5-5

# ถ้าใช้ Ollama (ฟรี รันในเครื่อง)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_URL=http://localhost:11434

# ฟอนต์ซับไตเติล (ปกติเลือกให้อัตโนมัติ: Windows=Tahoma, Mac=Thonburi, Linux=Loma)
# SUB_FONT=Tahoma

# พอร์ตของเว็บ
PORT=8000
